# ==========================================================
# PROTECCION DE DATOS - NO ELIMINAR NI RELAJAR ESTAS REGLAS
# ==========================================================

# Datos reales: NUNCA se suben a GitHub
*.csv
*.xlsx
*.xls
*.xlsm
*.parquet
*.sav
*.dta
*.sqlite
*.db
*.rds
*.rda
*.RData

# Estructura local de datos
/data/raw/*
!/data/raw/.gitkeep
/data/bronze/*
!/data/bronze/.gitkeep
/data/silver/*
!/data/silver/.gitkeep
/data/gold/*
!/data/gold/.gitkeep

/data/raw/secop_ii/*
!/data/raw/secop_ii/.gitkeep
/data/raw/dane_ipm/*
!/data/raw/dane_ipm/.gitkeep
/data/raw/divipola/*
!/data/raw/divipola/.gitkeep

# Resultados generados
/outputs/*
!/outputs/.gitkeep
/outputs/tablas/*
!/outputs/tablas/.gitkeep
/outputs/figuras/*
!/outputs/figuras/.gitkeep

# Estructuras antiguas del proyecto
/datos/*
!/datos/.gitkeep
/resultados/*
!/resultados/.gitkeep
/salidas/
/exports/
/figuras/
/latex/

# Secretos y credenciales
.env
.env.*
*.pem
*.key
credentials*
secrets*
token*

# R
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Sistema / editor
Thumbs.db
.DS_Store
.vscode/
.idea/
